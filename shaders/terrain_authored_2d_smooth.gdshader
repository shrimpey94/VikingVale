 float gold=step(.40,abs(fract(p.x/2.0)-.5));color=mix(color,texture(weave_albedo,kit_uv).rgb*vec3(.83,.72,.42),gold*.65);
 albedo+=color*w;vec3 kit_normal=texture(weave_normal,kit_uv).rgb*2.0-1.0;

