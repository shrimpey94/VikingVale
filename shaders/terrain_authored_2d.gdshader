 albedo+=color*w;vec3 kit_normal=texture(flagstone_normal,kit_uv).rgb*2.0-1.0;

 normal+=kit_normal*w;orm+=texture(flagstone_orm,kit_uv).rgb*w;
 }
 if(weights[28]>.00001){
