# ── Godot ─────────────────────────────────────────────────────────────────────
# Engine cache + imported asset binaries — regenerated on first open.
.godot/
.import/
*.translation
/android/
# Exported builds (the game .exe ships via GitHub Releases, NOT via git).
export/
exports/
*.pck
*.exe

# ── Python (server + updater) ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.python-version

# ── PyInstaller (updater build artifacts) ─────────────────────────────────────
build/
dist/
*.spec

# ── Runtime data (NEVER commit live game state) ───────────────────────────────
# game_server.db is the live SQLite DB — contains player accounts + passwords.
game_server.db
game_server.db-wal
game_server.db-shm
game_server.db-journal
# Legacy / pre-consolidation flat files left as .bak by migration v2/v3.
*.bak
*.tmp
# Legacy JSON stores (kept until migration is verified, but never tracked).
tile_overrides.json
shop_stock.json

# ── Local IDE / editor ────────────────────────────────────────────────────────
.vscode/
.vs/
.idea/
.claude/
*.swp
*.swo

# ── OS junk ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── Logs + secrets ────────────────────────────────────────────────────────────
*.log
.env
.env.*
credentials.json
# Discord release-webhook URL (read by release.bat). NEVER commit — anyone with
# it can post as your server. Set the VIKINGVALE_DISCORD_WEBHOOK env var instead,
# or drop the URL in this local file.
.discord_webhook

# ── Android signing keystores (NEVER commit; losing or leaking them is a
# permanent disaster — release keystores can't be regenerated, and a leaked
# one lets anyone push fake updates to your players).
*.keystore
*.jks
build/*.keystore

# Private: public repo
game_server.db*
ADMIN_EDITOR_AUDIT.md
CONTENT_AUDIT.md
QUEST_QA.md
LORE_BIBLE.md
MAIN_QUEST_OUTLINE.md
POST_170_PLAN.md
VO_SCRIPT.md

# Art pipeline — sources, captures and planning stay local / private art repo.
# Only the runtime exports in assets/authored/ (current versions) are public.
*.blend
*.blend1
art_source/previews/
art_source/archive/
ASSET_REPLACEMENT_PLAN.md
ASSET_PRODUCTION_TRACKER.md
docs/art/
